    {
      "id": "drafts_ijf_d_26_00175_r3_net_change_operation",
      "label": "Net Change Operation",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "Dynamic Forecast Rotation & Sticky Expectations",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "net change operation",
      "rationale": "Shrinks monitoring variable contributions to zero unless values breach multi-year highs or lows (m=3 years), suppressing noise and preventing spurious forecast rotations.",
