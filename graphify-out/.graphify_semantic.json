    {
      "id": "drafts_ijf_d_26_00175_r3_manuscript_pdf",
      "label": "A Beta-Binomial Algorithm for Forecasting the Price of Crude Oil",
      "file_type": "paper",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": "Nima Nonejad",
      "contributor": null
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_beta_binomial_algorithm",
      "label": "Beta-Binomial Forecasting Algorithm",
      "file_type": "rationale",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.4",
      "source_url": null,
      "captured_at": null,
      "author": "Nima Nonejad",
      "contributor": null,
      "rationale": "Performs real-time selection between the benchmark point forecast and predictive regressions by combining dynamic forecast rotation with Bayesian beta-binomial shrinkage based on past sign-matching performance."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_dynamic_forecast_rotation",
      "label": "Dynamic Forecast Rotation (DFR)",
      "file_type": "rationale",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Models squared point forecast error differences against state-of-the-world monitoring variables to identify ex-ante relative predictability and rotate into/out of predictability windows."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_bayesian_beta_binomial_model",
      "label": "Bayesian Beta-Binomial Conjugate Model",
      "file_type": "rationale",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Conjugate prior-likelihood framework that models probability of matching predicted and realized loss differential signs, producing closed-form posterior mean for model cutoff thresholding."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_windows_of_predictability",
      "label": "Windows of Predictability",
      "file_type": "concept",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.2, 3.3, 4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Short-lived episodes where financial/geopolitical shocks trigger market inefficiencies and information underreaction, allowing predictive regressions to outperform the random walk."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_sticky_expectations_theory",
      "label": "Sticky Expectations Theory",
      "file_type": "rationale",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.2, 3.3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Information processing costs lead agents to update expectations periodically rather than continuously, creating sluggish price adjustment in the wake of economic and geopolitical shocks."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_random_walk_benchmark",
      "label": "End-of-Month Price Random-Walk Benchmark",
      "file_type": "concept",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 1, 2.1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Predicts month-t+k oil price using closing price of the last business day of month t; eliminates spurious predictability artifacts of monthly averaging."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_dynamic_linear_model",
      "label": "Dynamic Linear Model (DLM) Base Predictive Models",
      "file_type": "concept",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Time-varying parameter regression specification for base predictive models estimated in real time via Kalman filtering."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_net_change_operation",
      "label": "Net Change Operation",
      "file_type": "rationale",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Shrinks monitoring variable contributions to zero unless values breach multi-year highs or lows (m=3 years), suppressing noise and preventing spurious forecast rotations."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_spike_and_slab_prior",
      "label": "Spike-and-Slab Prior Hyperparameter Averaging",
      "file_type": "rationale",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 2.4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Ties prior variance to candidate model count N and averages forecasts over candidate prior means weighted by predictive likelihood, eliminating subjective prior tuning."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_wti_crude_oil_price",
      "label": "Nominal End-of-Month WTI Spot Price",
      "file_type": "concept",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 3.1",
      "source_url": "https://stephensnudden.com/",
      "captured_at": "1986m1-2024m12",
      "author": null,
      "contributor": null,
      "rationale": "Primary forecast target; nominal price is preferred over real price to prevent measurement errors and distorted forecasts caused by deflators."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_monitoring_variables",
      "label": "Set of 18 Monitoring Variables",
      "file_type": "concept",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 3.3, Table 1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "18 series across business conditions, economic uncertainty, equity volatility, and geopolitical risk used to proxy the state of the world in loss differential regressions."
    },
    {
      "id": "drafts_ijf_d_26_00175_r3_mccracken_ng_database",
      "label": "FRED-MD Database of Economic Variables",
      "file_type": "concept",
      "source_file": "/Users/cory/Desktop/ifj-editor/nonejad-2026/drafts/IJF-D-26-00175_R3.pdf",
      "source_location": "Section 3.2",
      "source_url": "https://research.stlouisfed.org/econ/mccracken/fred-databases/",
      "captured_at": null,
      "author": "Michael W. McCracken, Serena Ng",
      "contributor": null,
      "rationale": "Provides over 120 stationary monthly macroeconomic and financial time series used in the individual base predictive regressions."
    },
